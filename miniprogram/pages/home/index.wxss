.home-page {
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
}

.nav-edge,
.catalog-heading,
.product-meta {
  align-items: center;
  display: flex;
  justify-content: space-between;
}

.nav-edge {
  border-bottom: var(--rule-hair) solid var(--color-rule);
  min-height: 96rpx;
}

.nav-action {
  background: var(--color-transparent);
  border-bottom: var(--rule-hair) solid var(--color-ink);
  border-radius: 0;
  color: var(--color-ink);
  font-size: var(--text-sm);
  line-height: 88rpx;
  margin: 0;
  min-height: 88rpx;
  padding: 0;
  white-space: nowrap;
}

.intro {
  display: grid;
  gap: var(--space-xl);
  padding: var(--space-lg) 0 var(--space-xl);
}

.intro-copy,
.intro-note {
  display: flex;
  flex-direction: column;
}

.intro-copy {
  gap: var(--space-sm);
}

.inventory-line,
.catalog-count,
.intro-note-title,
.media-note,
.product-material {
  color: var(--color-muted);
  font-size: var(--text-sm);
}

.intro-title {
  font-family: var(--font-display);
  font-size: var(--text-xl);
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1.16;
}

.intro-body {
  color: var(--color-ink-2);
  max-width: 30em;
}

.intro-note {
  border-top: var(--rule-hair) solid var(--color-rule-strong);
  color: var(--color-ink-2);
  gap: var(--space-xs);
  padding-top: var(--space-sm);
}

.intro-note-title {
  color: var(--color-accent);
}

.category-scroll {
  margin: 0 calc(var(--space-md) * -1);
  width: auto;
}

.category-rail {
  display: flex;
  gap: var(--space-xs);
  padding: 0 var(--space-md);
  width: max-content;
}

.category-chip {
  background: var(--color-transparent);
  border: var(--rule-hair) solid var(--color-rule);
  border-radius: var(--radius-sm);
  color: var(--color-ink-2);
  font-size: var(--text-sm);
  line-height: 80rpx;
  margin: 0;
  min-height: 80rpx;
  padding: 0 var(--space-md);
  white-space: nowrap;
}

.category-chip--active {
  background: var(--color-ink);
  border-color: var(--color-ink);
  color: var(--color-paper);
}

.catalog-heading {
  border-bottom: var(--rule-hair) solid var(--color-rule);
  padding-bottom: var(--space-sm);
}

.catalog-title {
  font-family: var(--font-display);
  font-size: var(--text-lg);
  font-weight: 700;
}

.product-grid {
  display: grid;
  gap: var(--space-xl);
}

.product-card {
  background: var(--color-transparent);
  border: 0;
  border-radius: 0;
  color: var(--color-ink);
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  margin: 0;
  padding: 0;
  text-align: left;
}

.product-media {
  align-items: center;
  aspect-ratio: 4 / 3;
  background: var(--color-paper-2);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  position: relative;
}

.product-media--amber,
.product-media--bronze {
  background: var(--color-paper-3);
}

.product-media--pearl,
.product-media--silver {
  background: var(--color-paper-2);
}

.product-mark {
  border: 2rpx solid var(--color-accent);
  border-radius: 50%;
  height: 136rpx;
  margin-bottom: var(--space-sm);
  width: 136rpx;
}

.product-media--earring .product-mark {
  height: 80rpx;
  width: 80rpx;
}

.product-meta {
  align-items: flex-start;
  gap: var(--space-md);
}

.product-meta > view {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: var(--space-2xs);
  min-width: 0;
}

.product-name {
  display: block;
  font-family: var(--font-display);
  font-size: var(--text-md);
  font-weight: 700;
  line-height: 1.3;
}

.product-link {
  border-bottom: var(--rule-hair) solid var(--color-accent);
  color: var(--color-accent);
  font-size: var(--text-sm);
  white-space: nowrap;
}

@media (min-width: 650px) {
  .product-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
